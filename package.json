{
  "name": "enduro-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/index.ts",
    "start": "node dist-server/server/index.js",
    "backfill:mototally": "node dist-server/scripts/backfill-mototally.js",
    "backfill:livelaps": "node dist-server/scripts/backfill-livelaps.js",
    "build": "rm -rf dist-server && vite build && tsc -p tsconfig.server.json && mkdir -p dist-server/server/archive && cp -R server/archive/migrations dist-server/server/archive/migrations",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "happy-dom": "^20.10.6",
    "supertest": "^7.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "express": "^5.0.0",
    "linkedom": "^0.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
